# Get your own API key from https://platform.openai.com/api-keys
# Never put this key in public/index.html or commit your .env file.
OPENAI_API_KEY=sk-replace-with-your-real-api-key
OPENAI_MODEL=gpt-6-luna
PORT=3000
NODE_ENV=development

# MySQL database: setup tables with sql/schema.sql before starting
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=lac_lac_app
MYSQL_PASSWORD=replace-with-your-mysql-password
MYSQL_DATABASE=lac_lac
# Set true when your cloud database supports verified TLS certificates
MYSQL_SSL=false

# IMPORTANT: 32+ cryptographically random characters, same value across deployments.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-with-a-long-random-string-at-least-32-characters
